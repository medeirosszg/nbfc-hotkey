def run(cmd, root=False, capture=True, check=False, env=None, cwd=None):
    """Roda um comando. root=True usa sudo (se ainda não formos root)."""
    if root and os.geteuid() != 0:
        cmd = ["sudo"] + list(cmd)
    if DRY_RUN and (root or cmd[0] in ("apt-get", "dnf", "zypper", "pacman")):
        print(_c("2", "[dry-run] " + " ".join(shlex.quote(c) for c in cmd)))
        return subprocess.CompletedProcess(cmd, 0, "", "")
    try:
        r = subprocess.run(cmd, stdout=subprocess.PIPE if capture else None,
                           stderr=subprocess.PIPE if capture else None,
                           universal_newlines=True, env=env, cwd=cwd)
    except FileNotFoundError:
        r = subprocess.CompletedProcess(cmd, 127, "", "%s: not found" % cmd[0])
    if check and r.returncode != 0:
        die(t("Comando falhou: ", "Command failed: ") + " ".join(cmd) +
            ("\n" + (r.stderr or "").strip() if capture else ""))
    return r


def have(prog):
    return shutil.which(prog) is not None


def sudo_warmup():
    """Pede a senha do sudo uma vez, antes de começar."""
    if os.geteuid() == 0 or DRY_RUN:
        return True
    if not have("sudo"):
        die(t("sudo não encontrado. Rode como um usuário com sudo.",
              "sudo not found. Run as a user with sudo."))
    return subprocess.call(["sudo", "-v"]) == 0


def notify(title, body="", icon="dialog-information"):
    if have("notify-send"):
        subprocess.call(["notify-send", "-a", "NBFC", "-i", icon, title, body],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


