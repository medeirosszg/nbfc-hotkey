}
BUILD_DEPS["ubuntu"] = BUILD_DEPS["mint"] = BUILD_DEPS["debian"]


def nbfc_works():
    return have("nbfc") and run(["nbfc", "--version"]).returncode == 0


def build_nbfc_from_source(tag, fam):
    info(t("Compilando o NBFC-Linux a partir do código-fonte...", "Building NBFC-Linux from source..."))
    deps = BUILD_DEPS.get(fam)
    if deps:
        info(t("Instalando as dependências de compilação", "Installing build dependencies"))
        if run(deps, root=True, capture=False).returncode != 0:
            die(t("Não consegui instalar as dependências de compilação.", "Could not install build dependencies."))
    else:
        need = [p for p in ("gcc", "make", "autoconf", "automake", "pkg-config") if not have(p)]
        if need:
            die(t("Instale antes: ", "Please install first: ") + " ".join(need) +
                t(" e as bibliotecas de desenvolvimento de libcurl, openssl, libxml2 e lua.",
                  " plus the development headers for libcurl, openssl, libxml2 and lua."))
    work = tempfile.mkdtemp(prefix=APP + "-src-")
    tgz = os.path.join(work, "src.tar.gz")
    with open(tgz, "wb") as f:
        f.write(http_get("https://github.com/%s/archive/refs/tags/%s.tar.gz" % (NBFC_REPO, tag)))
    with tarfile.open(tgz) as tf:
        if hasattr(tarfile, "data_filter"):
            tf.extractall(work, filter="data")
        else:
            tf.extractall(work)
    src = [d for d in glob.glob(os.path.join(work, "nbfc-linux-*")) if os.path.isdir(d)][0]
    conf = ["./configure", "--prefix=/usr", "--sysconfdir=/etc"]
    if not (has_systemd() or have("systemctl")):
        conf.append("--with-init-system=openrc" if have("openrc") else "--with-init-system=systemv")
    for step in (["./autogen.sh"], conf, ["make", "-j%d" % (os.cpu_count() or 2)]):
        if run(step, cwd=src, capture=False).returncode != 0:
            die(t("A compilação falhou em: ", "Build failed at: ") + " ".join(step))
    if run(["make", "install"], root=True, cwd=src, capture=False).returncode != 0:
        die(t("make install falhou", "make install failed"))
    return True


def install_nbfc(fam, osr, force=False):
    if have("nbfc") and not force:
        ok(t("NBFC-Linux já instalado (versão %s)", "NBFC-Linux already installed (version %s)") % nbfc_version())
    else:
        rel = latest_release(NBFC_REPO)
        asset = pick_nbfc_asset(rel["assets"], fam, osr)
        if asset:
            with tempfile.TemporaryDirectory(prefix=APP + "-") as d:
                if not install_package_file(download_asset(asset, d), fam):
                    die(t("Falha ao instalar o pacote do NBFC-Linux.", "Failed to install the NBFC-Linux package."))
            if not nbfc_works() and not DRY_RUN:
                # Ex.: o pacote oficial do openSUSE às vezes é compilado contra bibliotecas antigas
                warn(t("O pacote oficial instalou, mas o `nbfc` não roda nesta versão da distro. "
                       "Vou trocá-lo por uma compilação local.",
                       "The official package installed but `nbfc` does not run on this distro version. "
                       "Replacing it with a local build."))
                pkg = "nbfc-linux-git" if fam == "arch" else "nbfc-linux"
                remove = {"arch": ["pacman", "-R", "--noconfirm", pkg],
                          "fedora": ["dnf", "remove", "-y", pkg],
                          "opensuse": ["zypper", "--non-interactive", "remove", pkg]}.get(
                    fam, ["apt-get", "remove", "-y", pkg])
                run(remove, root=True, capture=False)
                build_nbfc_from_source(rel["tag_name"], fam)
        else:
            info(t("Não há pacote pronto para esta distro.", "No prebuilt package for this distro."))
            build_nbfc_from_source(rel["tag_name"], fam)
        if not nbfc_works() and not DRY_RUN:
            die(t("O NBFC-Linux foi instalado, mas o comando `nbfc` não funciona.",
                  "NBFC-Linux was installed but the `nbfc` command does not work."))
        ok(t("NBFC-Linux instalado", "NBFC-Linux installed"))

    if have("nbfc-qt") and not force:
        ok(t("Painel nbfc-qt já instalado", "nbfc-qt panel already installed"))
        return
    rel = latest_release(NBFC_QT_REPO)
    asset = pick_nbfc_qt_asset(rel["assets"], fam)
    if not asset:
        warn(t("Não há pacote do painel nbfc-qt para esta distro. Instale manualmente: "
               "https://github.com/nbfc-linux/nbfc-qt (a tecla pode rodar outro comando).",
               "No nbfc-qt package for this distro. Install it manually: "
               "https://github.com/nbfc-linux/nbfc-qt (the key can run another command)."))
        return
    with tempfile.TemporaryDirectory(prefix=APP + "-") as d:
        if install_package_file(download_asset(asset, d), fam):
            ok(t("Painel nbfc-qt instalado", "nbfc-qt panel installed"))
        else:
            warn(t("Falha ao instalar o nbfc-qt.", "Failed to install nbfc-qt."))


# --------------------------------------------------------------------------
# Configuração do NBFC para o modelo do notebook
# --------------------------------------------------------------------------

def configure_nbfc(reconfigure=False):
    current = nbfc_selected_config()
    if current and nbfc_service_ok() and not reconfigure:
        ok(t("NBFC já configurado (\"%s\") e serviço rodando", "NBFC already configured (\"%s\") and running") % current)
        return True

    model = read_dmi("product_name")
    info(t("Procurando configuração para: ", "Looking for a config for: ") + (model or "?"))
    run(["nbfc", "update"], root=True)   # baixa as configurações mais recentes

    r = run(["nbfc", "config", "--set", "auto"], root=True)
    if r.returncode == 0:
        ok(t("Configuração escolhida automaticamente", "Config selected automatically"))
    else:
        rec = [l.strip() for l in run(["nbfc", "config", "--recommend"]).stdout.splitlines() if l.strip()]
        if not rec:
            warn(t("Nenhuma configuração reconhece este notebook. Veja `nbfc config --list` e "
                   "https://github.com/nbfc-linux/nbfc-linux#getting-started-without-the-gui",
                   "No config matches this laptop. See `nbfc config --list` and "
                   "https://github.com/nbfc-linux/nbfc-linux#getting-started-without-the-gui"))
            return False
        i = ask_choice(t("Configurações que podem servir no seu notebook:",
                         "Configs that may work on your laptop:"), rec[:15])
        if run(["nbfc", "config", "--set", rec[i]], root=True).returncode != 0:
            warn(t("Não consegui aplicar a configuração.", "Could not apply the config."))
            return False
        ok(t("Configuração aplicada: ", "Config applied: ") + rec[i])

    if has_systemd():
        run(["systemctl", "enable", "nbfc_service"], root=True)
    run(["nbfc", "restart"], root=True)
    for _ in range(10):
        if nbfc_service_ok():
            ok(t("Serviço do NBFC rodando e ligado no boot", "NBFC service running and enabled at boot"))
            return True
        time.sleep(1)
    warn(t("O serviço do NBFC não iniciou. Causas comuns: Secure Boot bloqueando o acesso ao "
           "controlador (instale o módulo acpi_ec) ou configuração errada. Log:",
           "The NBFC service did not start. Common causes: Secure Boot blocking EC access "
           "(install the acpi_ec module) or a wrong config. Log:"))
    print(run(["journalctl", "-u", "nbfc_service", "-n", "15", "--no-pager"], root=True).stdout)
    return False


