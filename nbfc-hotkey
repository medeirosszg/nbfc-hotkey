def check_not_root():
    if os.geteuid() == 0 and not os.environ.get("NBFC_HOTKEY_ALLOW_ROOT"):
        die(t("Rode como seu usuário normal (sem sudo). Eu peço a senha quando precisar.",
              "Run as your normal user (not with sudo). I'll ask for the password when needed."))


def print_status():
    osr = os_release()
    de = desktop_env()
    cfg = load_config()
    print(_c("1", "%s %s" % (APP, VERSION)))
    print("  %-10s %s · %s (%s)" % (t("Sistema:", "System:"), osr.get("PRETTY_NAME", "Linux"),
                                     DE_NAMES.get(de, de), os.environ.get("XDG_SESSION_TYPE", "?")))
    print("  %-10s %s %s" % (t("Notebook:", "Laptop:"), read_dmi("sys_vendor"), read_dmi("product_name")))
    v = nbfc_version()
    if v:
        st = t("rodando", "running") if nbfc_service_ok() else t("parado", "stopped")
        print("  %-10s %s, %s, config \"%s\"" % ("NBFC:", v, st, nbfc_selected_config() or "-"))
    else:
        print("  %-10s %s" % ("NBFC:", t("não instalado", "not installed")))
    print("  %-10s %s" % (t("Painel:", "Panel:"), t("instalado", "installed") if have("nbfc-qt")
                          else t("não instalado", "not installed")))
    if cfg.get("binding"):
        act = t("abrir painel", "open panel") if cfg.get("action", "panel") == "panel" else cfg.get("command")
        print("  %-10s %s → %s" % (t("Tecla:", "Key:"), format_human(cfg["binding"]), act))
    else:
        print("  %-10s %s" % (t("Tecla:", "Key:"), t("nenhuma", "none")))


def cmd_install(args):
    if not args.only_packages:
        check_not_root()
    osr = os_release()
    fam = distro_family(osr)
    print_status()
    print()
    info(t("Distro detectada: família \"%s\"", "Detected distro family: \"%s\"") % fam)
    if not sudo_warmup():
        die(t("Preciso do sudo para instalar.", "sudo is required to install."))
    install_nbfc(fam, osr, force=args.reinstall)
    if args.only_packages:
        return 0
    configure_nbfc(reconfigure=args.reconfigure)
    install_user_files()
    cfg = load_config()
    cfg.setdefault("action", "panel")
    save_config(cfg)
    if args.no_bind:
        return 0
    b = parse_binding(args.key) if args.key else choose_key()
    if b:
        apply_binding(b)
    print()
    ok(t("Pronto! Aperte a tecla para abrir o painel de ventoinhas.",
         "Done! Press the key to open the fan panel."))
    return 0


def cmd_bind(args):
    check_not_root()
    if (not os.path.exists(INSTALLED_SELF)
            or os.path.realpath(sys.argv[0]) != os.path.realpath(INSTALLED_SELF)):
        install_user_files()      # instala ou atualiza a cópia em ~/.local/bin
    b = parse_binding(args.key) if args.key else choose_key()
    if not b:
        return 1
    return 0 if apply_binding(b) else 1


def cmd_unbind(_args):
    check_not_root()
    cfg = load_config()
    be = backend_for(cfg.get("desktop") or desktop_env())
    if be:
        be.unbind()
    cfg.pop("binding", None)
    save_config(cfg)
    ok(t("Atalho removido", "Shortcut removed"))
    return 0


def cmd_action(args):
    cfg = load_config()
    if args.what:
        choice = 0 if args.what == "panel" else 1
        command = args.command
    else:
        choice = ask_choice(t("O que a tecla deve fazer?", "What should the key do?"),
                            [t("Abrir/fechar o painel de ventoinhas (nbfc-qt)", "Open/close the fan panel (nbfc-qt)"),
                             t("Rodar outro comando", "Run another command")])
        command = ask_text(t("Comando", "Command"), cfg.get("command", "")) if choice == 1 else None
    if choice == 1:
        if not command:
            die(t("Informe o comando.", "Please give a command."))
        cfg["action"], cfg["command"] = "command", command
    else:
        cfg["action"] = "panel"
    save_config(cfg)
    ok(t("Ação salva", "Action saved"))
    return 0


def cmd_uninstall(_args):
    check_not_root()
    cmd_unbind(None)
    if os.path.exists(HWDB_FILE) and ask_yes(t("Remover também o remapeamento de tecla (%s)?",
                                               "Also remove the key remap (%s)?") % HWDB_FILE):
        run(["rm", "-f", HWDB_FILE], root=True)
        run(["systemd-hwdb", "update"], root=True)
        run(["udevadm", "trigger", "--subsystem-match=input", "--action=change"], root=True)
    shutil.rmtree(LIB_DIR, ignore_errors=True)
    shutil.rmtree(CONF_DIR, ignore_errors=True)
    for p in (INSTALLED_SELF,):
        try:
            os.remove(p)
        except OSError:
            pass
    ok(t("nbfc-hotkey removido. O NBFC-Linux e o nbfc-qt continuam instalados "
         "(remova pelo gerenciador de pacotes se quiser).",
         "nbfc-hotkey removed. NBFC-Linux and nbfc-qt are still installed "
         "(remove them with your package manager if you want)."))
    return 0


def cmd_menu(_args):
    check_not_root()
    while True:
        print()
        print_status()
        print()
        opts = [t("Instalar e configurar tudo", "Install and set up everything"),
                t("Escolher a tecla", "Choose the key"),
                t("Escolher o que a tecla faz", "Choose what the key does"),
                t("Testar (abrir o painel agora)", "Test (open the panel now)"),
                t("Remover o atalho", "Remove the shortcut"),
                t("Desinstalar o nbfc-hotkey", "Uninstall nbfc-hotkey"),
                t("Sair", "Quit")]
        i = ask_choice(t("O que você quer fazer?", "What do you want to do?"), opts, default=len(opts) - 1)
        ns = argparse.Namespace(key=None, only_packages=False, reinstall=False, reconfigure=False,
                                no_bind=False, what=None, command=None)
        if i == 0:
            cmd_install(ns)
        elif i == 1:
            cmd_bind(ns)
        elif i == 2:
            cmd_action(ns)
        elif i == 3:
            cmd_trigger()
        elif i == 4:
            cmd_unbind(ns)
        elif i == 5:
            if ask_yes(t("Tem certeza?", "Are you sure?"), False):
                return cmd_uninstall(ns)
        else:
            return 0


def main():
    global DRY_RUN, ASSUME_YES
    p = argparse.ArgumentParser(prog=APP, description=t(
        "Instala o NBFC-Linux e liga uma tecla do notebook ao painel de ventoinhas. "
        "Sem argumentos, abre um menu.",
        "Installs NBFC-Linux and binds a laptop key to the fan panel. With no arguments, opens a menu."))
    p.add_argument("--version", action="version", version="%s %s" % (APP, VERSION))
    p.add_argument("-y", "--yes", action="store_true", help=t("responde sim a tudo", "answer yes to everything"))
    p.add_argument("--dry-run", action="store_true",
                   help=t("só mostra os comandos de instalação", "only print install commands"))
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("install", help=t("instala e configura tudo", "install and set up everything"))
    s.add_argument("--key", help=t("tecla sem detecção (ex.: XF86Launch1, ctrl+alt+f)",
                                   "key without detection (e.g. XF86Launch1, ctrl+alt+f)"))
    s.add_argument("--no-bind", action="store_true", help=t("não cria o atalho", "don't create the shortcut"))
    s.add_argument("--only-packages", action="store_true",
                   help=t("só instala os pacotes do NBFC", "only install the NBFC packages"))
    s.add_argument("--reinstall", action="store_true", help=t("reinstala os pacotes", "reinstall packages"))
    s.add_argument("--reconfigure", action="store_true",
                   help=t("escolhe a configuração do notebook de novo", "pick the laptop config again"))
    s.set_defaults(func=cmd_install)

    s = sub.add_parser("bind", help=t("escolhe a tecla", "choose the key"))
    s.add_argument("--key", help=t("tecla sem detecção", "key without detection"))
    s.set_defaults(func=cmd_bind)

    s = sub.add_parser("action", help=t("escolhe o que a tecla faz", "choose what the key does"))
    s.add_argument("what", nargs="?", choices=["panel", "command"])
    s.add_argument("command", nargs="?")
    s.set_defaults(func=cmd_action)

    sub.add_parser("status", help=t("mostra o estado", "show status")).set_defaults(
        func=lambda a: print_status() or 0)
    sub.add_parser("unbind", help=t("remove o atalho", "remove the shortcut")).set_defaults(func=cmd_unbind)
    sub.add_parser("uninstall", help=t("desinstala o nbfc-hotkey", "uninstall nbfc-hotkey")).set_defaults(
        func=cmd_uninstall)
    sub.add_parser("trigger", help=t("o que o atalho executa", "what the shortcut runs")).set_defaults(
        func=cmd_trigger)
    s = sub.add_parser("_capture")
    s.add_argument("--timeout", type=float, default=20)
    s.set_defaults(func=lambda a: capture_key_root(a.timeout))

    args = p.parse_args()
    DRY_RUN, ASSUME_YES = args.dry_run, args.yes
    if not args.cmd:
        return cmd_menu(args)
    try:
        return args.func(args) or 0
    except KeyboardInterrupt:
        print()
        return 130
    except urllib.error.URLError as e:
        die(t("Erro de rede: ", "Network error: ") + str(e))


if __name__ == "__main__":
    sys.exit(main())
