_lang = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "").lower()
PT = _lang.startswith("pt")


def t(pt, en):
    return pt if PT else en


_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _c(code, s):
    return "\033[%sm%s\033[0m" % (code, s) if _COLOR else s


def info(msg):
    print(_c("1;34", "::") + " " + msg)


def ok(msg):
    print(_c("1;32", "✓") + " " + msg)


def warn(msg):
    print(_c("1;33", "!") + " " + msg, file=sys.stderr)


def err(msg):
    print(_c("1;31", "✗") + " " + msg, file=sys.stderr)


def die(msg, code=1):
    err(msg)
    sys.exit(code)


def ask_yes(question, default=True):
    if ASSUME_YES:
        return default
    hint = t("[S/n]", "[Y/n]") if default else t("[s/N]", "[y/N]")
    while True:
        try:
            ans = input("%s %s " % (question, hint)).strip().lower()
        except EOFError:
            return default
        if not ans:
            return default
        if ans[0] in "sy":
            return True
        if ans[0] == "n":
            return False


def ask_choice(question, options, default=0):
    """Mostra uma lista numerada e devolve o índice escolhido."""
    if ASSUME_YES:
        return default
    print(question)
    for i, opt in enumerate(options, 1):
        mark = _c("1", " (padrão)" if PT else " (default)") if i - 1 == default else ""
        print("  %d) %s%s" % (i, opt, mark))
    while True:
        try:
            ans = input("> ").strip()
        except EOFError:
            return default
        if not ans:
            return default
        if ans.isdigit() and 1 <= int(ans) <= len(options):
            return int(ans) - 1


def ask_text(question, default=""):
    if ASSUME_YES:
        return default
    try:
        ans = input("%s%s: " % (question, " [%s]" % default if default else "")).strip()
    except EOFError:
        return default
    return ans or default


