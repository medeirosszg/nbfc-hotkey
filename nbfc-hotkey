def os_release():
    d = {}
    for p in ("/etc/os-release", "/usr/lib/os-release"):
        try:
            with open(p) as f:
                for line in f:
                    line = line.strip()
                    if "=" in line and not line.startswith("#"):
                        k, v = line.split("=", 1)
                        d[k] = v.strip().strip('"').strip("'")
            break
        except OSError:
            continue
    return d


def distro_family(osr):
    did = osr.get("ID", "").lower()
    like = osr.get("ID_LIKE", "").lower().split()
    ids = [did] + like
    if did in ("arch", "manjaro", "endeavouros", "cachyos", "garuda", "artix") or "arch" in like:
        return "arch"
    if did == "linuxmint":
        return "mint" if "ubuntu" in like else "debian"   # LMDE é baseado no Debian
    if did == "ubuntu" or "ubuntu" in like:
        return "ubuntu"
    if "debian" in ids:
        return "debian"
    if did == "fedora" or "fedora" in like:
        return "fedora"
    if any(i.startswith("opensuse") or i == "suse" for i in ids):
        return "opensuse"
    return "other"


def read_dmi(name):
    try:
        with open("/sys/class/dmi/id/" + name) as f:
            return f.read().strip()
    except OSError:
        return ""


def desktop_env():
    raw = (os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("DESKTOP_SESSION") or "").lower()
    parts = re.split(r"[:;]", raw)
    for p in parts:
        if "cinnamon" in p:
            return "cinnamon"
        if p == "mate":
            return "mate"
        if "xfce" in p:
            return "xfce"
        if p in ("kde", "plasma"):
            return "kde"
        if p == "sway":
            return "sway"
        if p == "hyprland":
            return "hyprland"
        if p == "i3":
            return "i3"
    for p in parts:
        if p in ("gnome", "unity", "budgie", "budgie-desktop", "pantheon", "ubuntu", "gnome-classic", "pop", "cosmic"):
            return "gnome" if p != "cosmic" else "cosmic"
    if os.environ.get("SWAYSOCK"):
        return "sway"
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return "hyprland"
    return "unknown"


