class XfceBackend:
    channel = "xfce4-keyboard-shortcuts"

    def _ours(self):
        r = run(["xfconf-query", "-c", self.channel, "-l", "-v"])
        out = []
        for line in r.stdout.splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2 and parts[0].startswith("/commands/custom/") and APP + " trigger" in parts[1]:
                out.append(parts[0])
        return out

    def conflicts(self, b):
        prop = "/commands/custom/" + fmt_gtk(b, ctrl="<Primary>")
        r = run(["xfconf-query", "-c", self.channel, "-p", prop])
        return [r.stdout.strip()] if r.returncode == 0 and APP not in r.stdout else []

    def bind(self, b, command):
        self.unbind()
        prop = "/commands/custom/" + fmt_gtk(b, ctrl="<Primary>")
        return run(["xfconf-query", "-c", self.channel, "-p", prop, "-n", "-t", "string",
                    "-s", command]).returncode == 0

    def unbind(self):
        for p in self._ours():
            run(["xfconf-query", "-c", self.channel, "-p", p, "-r"])
        return True


class KdeBackend:
    desktop_id = APP + ".desktop"

    def _desktop_path(self):
        return os.path.join(HOME, ".local", "share", "applications", self.desktop_id)

    def _kwrite(self):
        return shutil.which("kwriteconfig6") or shutil.which("kwriteconfig5")

    def conflicts(self, b):
        return []

    def _reload(self):
        if run(["systemctl", "--user", "restart", "plasma-kglobalaccel.service"]).returncode != 0:
            run(["kquitapp5", "kglobalaccel"])
            if have("kglobalaccel5"):
                subprocess.Popen(["kglobalaccel5"], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def bind(self, b, command):
        kw = self._kwrite()
        if not kw:
            return False
        os.makedirs(os.path.dirname(self._desktop_path()), exist_ok=True)
        with open(self._desktop_path(), "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=%s\nExec=%s\nIcon=weather-windy\n"
                    "NoDisplay=true\nX-KDE-GlobalAccel-CommandShortcut=true\n" % (SHORTCUT_NAME, command))
        r = run([kw, "--file", "kglobalshortcutsrc", "--group", "services", "--group", self.desktop_id,
                 "--key", "_launch", fmt_qt(b)])
        self._reload()
        return r.returncode == 0

    def unbind(self):
        kw = self._kwrite()
        if kw:
            run([kw, "--file", "kglobalshortcutsrc", "--group", "services", "--group", self.desktop_id,
                 "--key", "_launch", "--delete"])
        try:
            os.remove(self._desktop_path())
        except OSError:
            pass
        self._reload()
        return True


class ConfigFileBackend:
    """Sway, i3 e Hyprland: acrescenta um bloco marcado no arquivo de configuração."""
    BEGIN, END = "# >>> nbfc-hotkey >>>", "# <<< nbfc-hotkey <<<"

    def __init__(self, kind):
        self.kind = kind

    def path(self):
        cands = {"sway": ["~/.config/sway/config"],
                 "i3": ["~/.config/i3/config", "~/.i3/config"],
                 "hyprland": ["~/.config/hypr/hyprland.conf"]}[self.kind]
        for c in cands:
            if os.path.exists(os.path.expanduser(c)):
                return os.path.expanduser(c)
        return os.path.expanduser(cands[0])

    def line(self, b, command):
        if self.kind == "hyprland":
            return "bind = %s, exec, %s" % (fmt_hypr(b), command)
        return "bindsym %s exec %s" % (fmt_sway(b), command)

    def conflicts(self, b):
        return []

    def _strip(self, text):
        return re.sub(r"\n?%s.*?%s\n?" % (re.escape(self.BEGIN), re.escape(self.END)), "\n", text, flags=re.S)

    def bind(self, b, command):
        p = self.path()
        try:
            with open(p) as f:
                text = f.read()
        except OSError:
            text = ""
        text = self._strip(text).rstrip("\n") + "\n\n%s\n%s\n%s\n" % (self.BEGIN, self.line(b, command), self.END)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as f:
            f.write(text)
        self._reload()
        return True

    def unbind(self):
        p = self.path()
        try:
            with open(p) as f:
                text = f.read()
        except OSError:
            return True
        with open(p, "w") as f:
            f.write(self._strip(text))
        self._reload()
        return True

    def _reload(self):
        if self.kind == "sway":
            run(["swaymsg", "reload"])
        elif self.kind == "i3":
            run(["i3-msg", "reload"])
        # Hyprland recarrega sozinho quando o arquivo muda


def backend_for(de):
    if de in ("sway", "i3", "hyprland"):
        return ConfigFileBackend(de)
    cls = {"gnome": GnomeBackend, "cinnamon": CinnamonBackend, "mate": MateBackend,
           "xfce": XfceBackend, "kde": KdeBackend}.get(de)
    return cls() if cls else None


