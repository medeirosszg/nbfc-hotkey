def http_get(url, accept=None):
    req = urllib.request.Request(url, headers={"User-Agent": APP + "/" + VERSION})
    if accept:
        req.add_header("Accept", accept)
    for attempt in range(4):
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                return r.read()
        except urllib.error.HTTPError as e:
            if e.code < 500 or attempt == 3:
                raise
        except (urllib.error.URLError, OSError):
            if attempt == 3:
                raise
        time.sleep(2 * (attempt + 1))     # o GitHub às vezes responde 5xx; tenta de novo


def latest_release(repo):
    data = http_get("https://api.github.com/repos/%s/releases/latest" % repo,
                    "application/vnd.github+json")
    return json.loads(data.decode())


def download_asset(asset, dest_dir):
    path = os.path.join(dest_dir, asset["name"])
    info(t("Baixando ", "Downloading ") + asset["name"])
    data = http_get(asset["browser_download_url"])
    digest = asset.get("digest") or ""
    if digest.startswith("sha256:"):
        if hashlib.sha256(data).hexdigest() != digest.split(":", 1)[1]:
            die(t("O arquivo baixado não bate com o checksum do GitHub: ",
                  "Downloaded file does not match GitHub checksum: ") + asset["name"])
        ok(t("Checksum SHA-256 conferido", "SHA-256 checksum verified"))
    with open(path, "wb") as f:
        f.write(data)
    return path


def _find(assets, prefix, suffix=""):
    for a in assets:
        if a["name"].startswith(prefix) and a["name"].endswith(suffix):
            return a
    return None


def pick_nbfc_asset(assets, fam, osr):
    import platform
    if platform.machine() not in ("x86_64", "amd64"):
        return None
    ver = osr.get("VERSION_ID", "")
    if fam == "arch":
        return _find(assets, "arch-linux-", ".pkg.tar.zst")
    if fam == "fedora":
        return _find(assets, "fedora-%s-" % ver.split(".")[0], ".rpm")
    if fam == "opensuse":
        return _find(assets, "opensuse-", ".rpm")
    if fam == "mint":
        return _find(assets, "linux-mint-%s-" % ver.split(".")[0], ".deb")
    if fam == "ubuntu":
        code = osr.get("UBUNTU_CODENAME") or osr.get("VERSION_CODENAME", "")
        return _find(assets, "ubuntu-%s-" % code, ".deb")
    if fam == "debian":
        code = osr.get("DEBIAN_CODENAME") or osr.get("VERSION_CODENAME", "")
        return _find(assets, "debian-%s-" % code, ".deb")
    return None


def pick_nbfc_qt_asset(assets, fam):
    prefix = {"arch": "arch-linux-", "fedora": "fedora-", "opensuse": "opensuse-",
              "debian": "debian-", "ubuntu": "debian-", "mint": "debian-"}.get(fam)
    return _find(assets, prefix) if prefix else None


def install_package_file(path, fam):
    if fam in ("debian", "ubuntu", "mint"):
        cmd = ["apt-get", "install", "-y", path]
    elif fam == "fedora":
        cmd = ["dnf", "install", "-y", path]
    elif fam == "opensuse":
        cmd = ["zypper", "--non-interactive", "install", "--allow-unsigned-rpm", path]
    elif fam == "arch":
        cmd = ["pacman", "-U", "--noconfirm", "--needed", path]
    else:
        return False
    if fam in ("debian", "ubuntu", "mint"):
        run(["apt-get", "update"], root=True, capture=False)
    if run(cmd, root=True, capture=False).returncode == 0:
        return True
    if fam == "arch":
        warn(t("Dica: atualize o sistema antes (sudo pacman -Syu) e rode de novo.",
               "Hint: update your system first (sudo pacman -Syu) and try again."))
    return False


BUILD_DEPS = {
    "fedora": ["dnf", "install", "-y", "gcc", "make", "autoconf", "automake", "pkgconf-pkg-config",
               "libcurl-devel", "openssl-devel", "libxml2-devel", "lua-devel", "gawk"],
    "opensuse": ["zypper", "--non-interactive", "install", "gcc", "make", "autoconf", "automake",
                 "pkg-config", "libcurl-devel", "libopenssl-devel", "libxml2-devel", "lua54-devel", "gawk"],
    "debian": ["apt-get", "install", "-y", "build-essential", "autoconf", "automake", "pkg-config",
               "libcurl4-openssl-dev", "libssl-dev", "libxml2-dev", "liblua5.4-dev", "gawk"],
