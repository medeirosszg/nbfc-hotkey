def capture_key_root(timeout):
    """Roda como root. Espera uma tecla e imprime JSON com código, scancode e dispositivo."""
    fds = {}
    for dev in sorted(glob.glob("/dev/input/event*")):
        base = "/sys/class/input/%s/device" % os.path.basename(dev)
        try:
            with open(base + "/capabilities/ev") as f:
                if not int(f.read().strip(), 16) & (1 << EV_KEY):
                    continue
            with open(base + "/name") as f:
                name = f.read().strip()
            fds[os.open(dev, os.O_RDONLY | os.O_NONBLOCK)] = name
        except (OSError, ValueError):
            continue
    mods, scans = set(), {}
    deadline = time.time() + timeout
    while time.time() < deadline:
        ready, _, _ = select.select(list(fds), [], [], max(0.05, deadline - time.time()))
        for fd in ready:
            try:
                data = os.read(fd, EVENT.size * 64)
            except OSError:
                continue
            for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, typ, code, value = EVENT.unpack_from(data, off)
                if typ == EV_MSC and code == MSC_SCAN:
                    scans[fd] = value & 0xFFFFFFFF
                elif typ == EV_KEY:
                    if code in MODIFIERS:
                        (mods.add if value else mods.discard)(MODIFIERS[code])
                    elif value == 1 and not (0x100 <= code < 0x160):   # ignora botões de mouse
                        print(json.dumps({"code": code, "scan": scans.get(fd), "device": fds[fd],
                                          "mods": sorted(mods)}))
                        return 0
    print(json.dumps(None))
    return 0


def capture_key(timeout=20):
    if not sudo_warmup():
        die(t("Preciso do sudo para ler o teclado.", "sudo is needed to read the keyboard."))
    print()
    print(_c("1;36", t("  >>> Aperte a tecla (ou combinação) que vai abrir o painel. <<<",
                       "  >>> Press the key (or combination) that will open the panel. <<<")))
    print(t("      Você tem %d segundos.", "      You have %d seconds.") % timeout)
    cmd = [sys.executable, "-I", os.path.realpath(sys.argv[0]), "_capture", "--timeout", str(timeout)]
    if os.geteuid() != 0:
        cmd = ["sudo", "-n"] + cmd
    r = subprocess.run(cmd, stdout=subprocess.PIPE, universal_newlines=True)
    try:
