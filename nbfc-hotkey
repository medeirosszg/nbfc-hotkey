    print(t("  Crie um atalho de teclado personalizado no seu ambiente gráfico com:",
            "  Create a custom keyboard shortcut in your desktop with:"))
    print("    %s %s" % (t("Tecla:  ", "Key:    "), format_human(b) if b else "?"))
    print("    %s %s" % (t("Comando:", "Command:"), command))


def apply_binding(b, de=None):
    de = de or desktop_env()
    be = backend_for(de)
    cmd = trigger_command()
    if be is None:
        warn(t("Não sei criar atalhos no ambiente \"%s\" automaticamente.",
               "I don't know how to create shortcuts in \"%s\" automatically.") % DE_NAMES.get(de, de))
        manual_instructions(b, cmd)
        return False
    others = be.conflicts(b)
    if others:
        warn(t("Essa tecla já está em uso por: ", "That key is already used by: ") + ", ".join(map(str, others)))
        if hasattr(be, "disable_conflicts"):
            # Duas regras na mesma tecla não funcionam: o ambiente só reserva a tecla para uma.
            if not ask_yes(t("Tirar a tecla desse atalho e usá-la para o %s?",
                             "Remove the key from that shortcut and use it for %s?") % SHORTCUT_NAME):
                return False
            be.disable_conflicts(b)
        elif not ask_yes(t("Criar o atalho mesmo assim?", "Create the shortcut anyway?"), False):
            return False
    if be.bind(b, cmd):
        ok(t("Atalho criado no %s: %s → abrir o painel", "Shortcut created in %s: %s → open the panel")
           % (DE_NAMES.get(de, de), format_human(b)))
        if de == "kde":
            print(t("  (Suporte ao KDE é experimental. Se não funcionar, confira em Configurações → Atalhos.)",
                    "  (KDE support is experimental. If it doesn't work, check Settings → Shortcuts.)"))
        cfg = load_config()
        cfg["binding"], cfg["desktop"] = b, de
        save_config(cfg)
        return True
    warn(t("Não consegui criar o atalho.", "Could not create the shortcut."))
    manual_instructions(b, cmd)
    return False


