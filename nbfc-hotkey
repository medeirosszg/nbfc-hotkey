SHIM = """#!/bin/sh
# Criado pelo nbfc-hotkey. Usado só pelo painel nbfc-qt.
# Quando o driver NVIDIA está instalado mas não carregado (ex.: kernel novo sem
# o módulo compilado), o `nbfc` espera o sensor da NVIDIA para sempre e o painel
# trava antes de abrir. Aqui ele desiste depois de alguns segundos.
REAL="${NBFC_HOTKEY_REAL_PATH:-/usr/local/bin:/usr/bin:/bin}"
case "$1" in
    complete-sensors|sensors)
        timeout 4 /usr/bin/env PATH="$REAL" nbfc "$@" 2>/dev/null
        rc=$?
        [ "$rc" -eq 124 ] && exit 0
        exit "$rc" ;;
    *)
        PATH="$REAL" exec nbfc "$@" ;;
esac
"""


def install_user_files():
    os.makedirs(BIN_DIR, exist_ok=True)
    os.makedirs(SHIM_DIR, exist_ok=True)
    me = os.path.realpath(sys.argv[0])
    if me != os.path.realpath(INSTALLED_SELF):
        shutil.copyfile(me, INSTALLED_SELF)
    os.chmod(INSTALLED_SELF, 0o755)
    shim = os.path.join(SHIM_DIR, "nbfc")
    with open(shim, "w") as f:
        f.write(SHIM)
    os.chmod(shim, 0o755)
    ok(t("Instalado em ", "Installed to ") + INSTALLED_SELF)
    if BIN_DIR not in os.environ.get("PATH", "").split(":"):
        warn(t("%s não está no seu PATH; use o caminho completo para rodar o %s.",
               "%s is not in your PATH; use the full path to run %s.") % (BIN_DIR, APP))


def trigger_command():
    return INSTALLED_SELF + " trigger"


# --------------------------------------------------------------------------
# Ação da tecla (subcomando "trigger", chamado pelo atalho)
# --------------------------------------------------------------------------

def find_panel_pids():
    pids = []
    uid = os.getuid()
    for d in glob.glob("/proc/[0-9]*"):
        try:
            if os.stat(d).st_uid != uid:
                continue
            with open(d + "/cmdline", "rb") as f:
                args = f.read().split(b"\0")
        except OSError:
            continue
        if any(os.path.basename(a) == b"nbfc-qt" for a in args[:2]):
            pids.append(int(os.path.basename(d)))
    return pids


def _dbg(msg):
    if os.environ.get("NBFC_HOTKEY_DEBUG"):
        print("[trigger] " + msg, file=sys.stderr)


def cmd_trigger(_args=None):
    cfg = load_config()
    stamp = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), APP + ".last")
    now = time.time()
    try:
        with open(stamp) as f:
            if now - float(f.read() or 0) < 1.5:
                _dbg("ignorado (toque repetido)")
                return 0          # toque repetido: o painel ainda está abrindo
    except (OSError, ValueError):
        pass
    try:
        with open(stamp, "w") as f:
            f.write(str(now))
    except OSError:
        pass

    if cfg.get("action", "panel") == "command" and cfg.get("command"):
        subprocess.Popen(cfg["command"], shell=True, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0

    pids = find_panel_pids()
    _dbg("painéis abertos: %s" % pids)
    if pids:                      # já aberto: a tecla fecha
        for p in pids:
            try:
                os.kill(p, signal.SIGTERM)
            except OSError:
                pass
        return 0

    env = dict(os.environ)
    env["NBFC_HOTKEY_REAL_PATH"] = env.get("PATH", "/usr/bin:/bin")
    env["PATH"] = SHIM_DIR + ":" + env["NBFC_HOTKEY_REAL_PATH"]
    try:
        subprocess.Popen(["nbfc-qt", "--fans"], env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        notify("NBFC", t("O painel nbfc-qt não está instalado.", "The nbfc-qt panel is not installed."),
               "dialog-error")
        return 1
    if not nbfc_service_ok():
        notify("NBFC", t("O serviço nbfc_service não está rodando.", "nbfc_service is not running."),
               "dialog-warning")
    return 0


