    return "%s, %s" % (" ".join(m[x] for x in b["mods"]), b["keysym"])


def gsettings(*args):
    return run(["gsettings"] + list(args))


def _gvariant_list(s):
    s = s.strip()
    if s.startswith("@as"):
        s = s[3:].strip()
    try:
        return list(ast.literal_eval(s))
    except (ValueError, SyntaxError):
        return []


class GnomeBackend:
    """GNOME, Ubuntu, Budgie, Pantheon, Pop (gsd media-keys)."""
    schema = "org.gnome.settings-daemon.plugins.media-keys"
    key = "custom-keybindings"
    rschema = "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding"
    base = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/"
    cmd_key = "command"

    def entry(self, i):
        return self.base + "custom%d/" % i

    def entries(self):
        return _gvariant_list(gsettings("get", self.schema, self.key).stdout)

    def set_entries(self, lst):
        gsettings("set", self.schema, self.key, str(lst))

    def get(self, path, k):
        v = gsettings("get", "%s:%s" % (self.rschema, path), k).stdout.strip()
        try:
            return ast.literal_eval(v)
        except (ValueError, SyntaxError):
            return v

    def setk(self, path, k, v):
        return gsettings("set", "%s:%s" % (self.rschema, path), k, v).returncode == 0

    def path_of(self, item):
        return item

    def item_of(self, i):
        return self.entry(i)

    def binding_value(self, b):
        return fmt_gtk(b)

    def find_ours(self):
        for item in self.entries():
            if self.get(self.path_of(item), "name") == SHORTCUT_NAME:
                return item
        return None

    def conflicts(self, b):
        want = self.binding_value(b).lower()
        out = []
        for item in self.entries():
            p = self.path_of(item)
            v = self.get(p, "binding")
            vals = v if isinstance(v, list) else [v]
            if self.get(p, "name") != SHORTCUT_NAME and want in [str(x).lower() for x in vals]:
                out.append(self.get(p, "name"))
        return out

    empty_binding = "''"

    def disable_conflicts(self, b):
        """Tira a tecla dos outros atalhos (o atalho continua existindo, só sem tecla)."""
        want = self.binding_value(b).lower()
        for item in self.entries():
            p = self.path_of(item)
            v = self.get(p, "binding")
            vals = v if isinstance(v, list) else [v]
            if self.get(p, "name") != SHORTCUT_NAME and want in [str(x).lower() for x in vals]:
                self.setk(p, "binding", self.empty_binding)
        return True

    def bind(self, b, command):
        if not have("gsettings"):
            return False
        lst = self.entries()
        item = self.find_ours()
        if item is None:
            i = 0
            while self.item_of(i) in lst:
                i += 1
            item = self.item_of(i)
            lst.append(item)
        p = self.path_of(item)
        # Limpa a tecla antes de gravar: força o GNOME a reservá-la de novo (se antes
        # ela estava ocupada por outro atalho, ele não tenta sozinho).
        self.setk(p, "binding", self.empty_binding)
        ok_ = (self.setk(p, "name", SHORTCUT_NAME) and self.setk(p, self.cmd_key, command)
               and self.setk(p, "binding", self.binding_value(b)))
        self.set_entries(lst)
        return ok_

    def unbind(self):
        item = self.find_ours()
        if item is None:
            return True
        p = self.path_of(item)
        for k in ("name", self.cmd_key, "binding"):
            gsettings("reset", "%s:%s" % (self.rschema, p), k)
        self.set_entries([x for x in self.entries() if x != item])
        return True


