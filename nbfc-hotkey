def code_label(code):
    return KEYSYMS.get(code, t("código %d", "code %d") % code)


def remap_key(scan, device, target):
    """Cria uma regra no hwdb do udev para trocar o código de uma tecla."""
    entry = "evdev:name:%s:*\n KEYBOARD_KEY_%x=%s\n" % (device, scan, target)
    content = ""
    try:
        with open(HWDB_FILE) as f:
            content = f.read()
    except OSError:
        content = "# Gerado pelo nbfc-hotkey. Remova este arquivo para desfazer.\n"
    content = re.sub(r"evdev:name:%s:\*\n KEYBOARD_KEY_%x=\S+\n" % (re.escape(device), scan), "", content)
    content += entry
    p = subprocess.run((["sudo"] if os.geteuid() else []) + ["tee", HWDB_FILE],
                       input=content, stdout=subprocess.DEVNULL, universal_newlines=True)
    if p.returncode != 0:
        return False
    run(["systemd-hwdb", "update"], root=True)
    run(["udevadm", "trigger", "--subsystem-match=input", "--action=change"], root=True)
    time.sleep(1.5)
    return True


def choose_key():
    """Fluxo interativo: descobre a tecla e devolve {"keysym", "mods"}."""
    while True:
        k = capture_key()
        if k is None:
            warn(t("Nenhuma tecla chegou ao sistema.", "No key reached the system."))
            print(t("  Algumas teclas especiais (NitroSense, Armoury, Omen...) só funcionam com o driver\n"
                    "  do fabricante carregado (acer_wmi, asus_wmi, hp_wmi...). Você pode tentar de novo,\n"
                    "  usar outra tecla/combinação, ou digitar o nome do keysym manualmente.",
                    "  Some special keys (NitroSense, Armoury, Omen...) only work when the vendor driver\n"
                    "  is loaded (acer_wmi, asus_wmi, hp_wmi...). You can retry, use another key/combo,\n"
                    "  or type the keysym name manually."))
            i = ask_choice(t("O que fazer?", "What now?"),
                           [t("Tentar de novo", "Try again"), t("Digitar o keysym (ex.: XF86Launch1)",
                                                                "Type the keysym (e.g. XF86Launch1)"),
                            t("Cancelar", "Cancel")])
            if i == 0:
                continue
            if i == 1:
                return parse_binding(ask_text("Keysym"))
            return None

        code, mods = k["code"], norm_mods(k["mods"])
        info(t("Tecla detectada: %s (dispositivo \"%s\")", "Key detected: %s (device \"%s\")")
             % (code_label(code), k["device"]))
        if code in RESERVED:
            warn(t("Essa tecla já tem função no sistema (volume, brilho...).",
                   "That key already has a system function (volume, brightness...)."))
            if not ask_yes(t("Usar mesmo assim?", "Use it anyway?"), False):
                continue
        if code not in KEYSYMS:
            if k.get("scan") is None:
                warn(t("O sistema não tem nome para essa tecla e não dá para remapeá-la. Escolha outra.",
                       "The system has no name for this key and it cannot be remapped. Pick another."))
                continue
            used = {code}
            target = next((tg for tg in REMAP_TARGETS if tg[1] not in used), REMAP_TARGETS[0])
            print(t("  Essa tecla não tem um nome que o ambiente gráfico entenda. Posso remapeá-la\n"
                    "  para %s (regra do udev em %s).",
                    "  This key has no name the desktop understands. I can remap it to\n"
                    "  %s (udev rule in %s).") % (KEYSYMS[target[1]], HWDB_FILE))
            if not ask_yes(t("Remapear?", "Remap?")):
                continue
            if not remap_key(k["scan"], k["device"], target[0]):
                warn(t("Falha ao remapear.", "Remap failed."))
                continue
            ok(t("Remapeada. Aperte a tecla de novo para confirmar.", "Remapped. Press the key again to confirm."))
            k2 = capture_key(15)
            if not k2 or k2["code"] != target[1]:
                warn(t("O remapeamento não funcionou para essa tecla.", "The remap did not work for this key."))
                continue
            code, mods = target[1], norm_mods(k2["mods"])
        b = {"keysym": KEYSYMS[code], "mods": mods}
        if not mods and len(b["keysym"]) == 1:
            warn(t("Uma letra sem Ctrl/Alt/Super atrapalharia a digitação. Use uma combinação.",
                   "A plain letter would break typing. Use a combination."))
            continue
        ok(t("Atalho: ", "Shortcut: ") + format_human(b))
        return b


def parse_binding(text):
    """Aceita 'XF86Launch1', 'ctrl+alt+f' ou '<Control><Alt>f'."""
    text = text.strip()
    if not text:
        return None
    mods = []
    alias = {"control": "ctrl", "ctrl": "ctrl", "primary": "ctrl", "alt": "alt", "mod1": "alt",
             "super": "super", "mod4": "super", "meta": "super", "win": "super", "shift": "shift"}
    for m in re.findall(r"<([^>]+)>", text):
        if m.lower() in alias:
            mods.append(alias[m.lower()])
    text = re.sub(r"<[^>]+>", "", text)
    parts = text.split("+")
    for p in parts[:-1]:
        if p.strip().lower() in alias:
            mods.append(alias[p.strip().lower()])
    key = parts[-1].strip()
    if len(key) == 1:
        key = key.lower()
    return {"keysym": key, "mods": norm_mods(mods)}


MOD_ORDER = ["ctrl", "alt", "shift", "super"]


def norm_mods(mods):
    return sorted(set(mods), key=MOD_ORDER.index)


def format_human(b):
    names = {"ctrl": "Ctrl", "alt": "Alt", "super": "Super", "shift": "Shift"}
    return "+".join([names[m] for m in b["mods"]] + [b["keysym"]])


